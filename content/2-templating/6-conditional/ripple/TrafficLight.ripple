import { track } from "ripple";

const TRAFFIC_LIGHTS = ["红灯", "黄灯", "绿灯"];

export component TrafficLight() {
  let lightIndex = track(0);

  const light = track(() => TRAFFIC_LIGHTS[@lightIndex]);

  function nextLight() {
    @lightIndex = (@lightIndex + 1) % TRAFFIC_LIGHTS.length;
  }

  <button onClick={nextLight}>{"下一个灯"}</button>
  <p>{`现在亮着的是: ${@light}`}</p>
  <p>
    {"你应该 "}
    if (@light === "红灯") {
      <span>{"停下"}</span>
    } else if (@light === "黄灯") {
      <span>{"慢行"}</span>
    } else if (@light === "绿灯") {
      <span>{"赶紧走"}</span>
    }
  </p>
}